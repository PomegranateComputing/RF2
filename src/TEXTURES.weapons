// First-person weapon families. One logical scale/offset per family, frame A = READY.
// FAL: 1536x1024 canvas. Browning: 1672x941 canvas. XScale 6.8 / YScale 8.16 / Offset -700,-300.
// FAL frames: Codex Astra batch RF01_P0_FAL (legacy master, continuous sleeve repair), promoted
// 2026-09-24 (docs/ASTRA_PROMOTION_RF01_P0_FAL_*.json). FIRE carries no flash: RFMZ A0 is the
// separate muzzle flash drawn on the flash layer at the same offset.

Sprite RFLVA0, 1536, 1024
{
    XScale 6.8
    YScale 8.16
    Offset -750, -460
    Patch "graphics/weapons/fal/RF2_FAL_READY_A0.png", 0, 0
}
