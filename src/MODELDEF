// Legacy S1 furniture: original OBJ meshes with one matte albedo atlas.
// OBJ export is Y-up; 0.32 world units per source centimetre, pixel stretch corrected.

Model RFPropDesk
{
    Path "models/props"
    Model 0 "desk.obj"
    Skin 0 "atlas.png"
    Scale 0.32 0.32 0.384
    CorrectPixelStretch
    IgnoreTranslation
    FrameIndex RFMD A 0 0
}
