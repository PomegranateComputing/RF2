ClearLocks

Lock 1 Doom
{
    RFPasseKey
    Message "$RF_LOCK_PASSE"
    RemoteMessage "$RF_LOCK_PASSE"
    Mapcolor 200 160 60
}

Lock 2 Doom
{
    RFGrilleKey
    Message "$RF_LOCK_GRILLE"
    RemoteMessage "$RF_LOCK_GRILLE"
    Mapcolor 80 120 200
}

// The porch grille has no key: it is raised from the porter's lodge winch. (An empty key list
// would mean "any key": RFNoKey is never obtainable.)
Lock 3 Doom
{
    RFNoKey
    Message "$RF_LOCK_PORCH"
    RemoteMessage "$RF_LOCK_PORCH"
    Mapcolor 160 40 40
}

// RF02: the Luna Park gate is padlocked (l. 455); the way in is the service door.
Lock 5 Doom
{
    RFNoKey
    Message "$RF_LOCK_LUNAPARK"
    RemoteMessage "$RF_LOCK_LUNAPARK"
    Mapcolor 160 40 40
}

// The gallery grille over the courtyard perron opens from the gallery side only.
Lock 4 Doom
{
    RFNoKey
    Message "$RF_LOCK_GALERIE"
    RemoteMessage "$RF_LOCK_GALERIE"
    Mapcolor 160 40 40
}

// RF04: the door of the substation, behind the roller coaster (l. 551), opens with its key from the hut (l. 497).
