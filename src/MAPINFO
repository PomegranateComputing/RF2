// RF02 (RF2-MAP-02): the walk of the novel from the boulevard Arago to the Porte Maillot. It leads to the Luna Park,
// RF04 (owner's decision of 27/09: the third narrative level keeps the technical ID RF04; RF03, Batignolles, stays a V1
// blockout for its later place in the novel, reachable by +map).
map RF02 "Paris - Rue de service"
{
    levelnum = 2
    next = "RF04"
    music = "RFAMB01"
    cluster = 1
    nointermission
    lightmode = 8
    sky1 = "RFSKY2", 0
}
map RF03 "Batignolles - Refus de reception" { levelnum = 3 next = "RF04" }
// RF04 (RF2 campaign, 30/09): the Luna Park, first passage (scripts/mapkit/rf04.py).
map RF04 "Luna Park - Personnel technique"
{
    levelnum = 4
    next = "RF05"
    music = "RFAMB01"
    cluster = 1
    nointermission
    lightmode = 8
    sky1 = "RFSKY2", 0
}
// RF05 (RF2 campaign, 30/09): under the Luna Park, then the park lit again (scripts/mapkit/rf05.py).
map RF05 "Les machines continuent"
{
    levelnum = 5
    next = "RF06"
    music = "RFAMB01"
    cluster = 1
    nointermission
    lightmode = 8
    sky1 = "RFSKY2", 0
}
// RF06 (RF2 campaign, 30/09): the corridor ERREUR Ø (scripts/mapkit/rf06.py), no combat. Ends on the title screen until
// RF07, the Jerma, is produced.
map RF06 "La sortie du personnel"
{
    levelnum = 6
    next = "EndTitle"
    music = "RFAMB01"
    cluster = 1
    nointermission
    lightmode = 8
}
