// RF02 - Paris, rue de service (novel lines 87-457). Scene texts quote or condense the novel.
RF_RF02_DATE = "Paris, vendredi 14 juin 1940";
RF_RF02_EXIT = "Le parc était fermé depuis près de dix ans.\nFermé ne signifiait pas absent.\n\nUne porte de service restait entrouverte.\nViktor passa.";
RF_OBJ_RF02_0 = "Marcher vers l'ouest.";
RF_OBJ_RF02_1 = "Traverser le carrefour du tramway.";
RF_OBJ_RF02_2 = "Continuer vers Port-Royal.";
RF_OBJ_RF02_3 = "Prendre la rue de Rennes.";
RF_OBJ_RF02_4 = "Descendre vers la Seine.";
RF_OBJ_RF02_5 = "Traverser le pont.";
RF_OBJ_RF02_6 = "Passer le barrage abandonné.";
RF_OBJ_RF02_7 = "Prendre les rues secondaires vers la porte Maillot.";
RF_OBJ_RF02_8 = "Entrer au Luna Park par la porte de service.";
RF_RF02_FORMS = "Des formulaires brûlent mal dans un seau galvanisé. Le papier administratif résiste par couches.\nDes morceaux de phrases montent dans la fumée : Domicile. Père inconnu. Autorisation. Conforme.";
RF_RF02_TICKET_1 = "Dans la sacoche du receveur : des tickets, une pince, quelques pièces, un livret d'horaires.\nViktor prend un ticket et le poinçonne.";
RF_RF02_TICKET_2 = "La perforation forme un cercle incomplet, barré par la morsure de la pince.\nIl range le ticket avec le bracelet.";
RF_RF02_TICKET_AGAIN = "La sacoche reste pendue à son crochet.";
RF_RF02_SHUTTER_1 = "Sur le rideau de fer, au pinceau noir : ERREUR Ø. Le même cercle trop appuyé.\nLa peinture est fraîche ; elle colle aux doigts.";
RF_RF02_SHUTTER_2 = "Il essuie ses doigts sur son pantalon.\nLa tache noire prend la forme d'un petit zéro barré près de la poche.";
RF_RF02_TSF_1 = "Derrière la grille, tous les postes sont allumés.\nEntre deux craquements, une voix annonce que Paris ne sera pas défendu.";
RF_RF02_TSF_2 = "Une autre, peut-être sur un poste voisin, parle de résistance sur la Loire.";
RF_RF02_TSF_3 = "Une troisième récite une publicité pour un sirop.";
RF_RF02_RADIO_1 = "Ce poste s'est arrêté ce matin. La lampe du cadran reste éteinte.\nViktor retire le panneau arrière et suit les fils. Un fusible a noirci.";
RF_RF02_RADIO_2 = "Dans une boîte sur le comptoir, il choisit le bon calibre et remplace la pièce.";
RF_RF02_RADIO_3 = "Un instant, le fusible devient une barrette de mémoire, la radio un châssis de serveur\nouvert sur une table antistatique. Puis le magasin revient.";
RF_RF02_RADIO_4 = "La lampe s'allume. Une voix allemande emplit la pièce, nette, proche,\nsuivie d'une marche militaire.";
RF_RF02_RADIO_5 = "Viktor éteint. Le silence après la radio est plus lourd que le bruit.";
RF_RF02_ATLAS_1 = "Histoire de France, annuaire des chemins de fer, traité de pathologie mentale, atlas des colonies.\nViktor ouvre l'atlas au hasard. Une fiche tombe.";
RF_RF02_ATLAS_2 = "Carte de lecteur, nom effacé, tampon du 12 décembre 2022.\nAu verso, une adresse à Malte et trois mots au crayon : JERMA - ERREUR Ø.\nIl conserve la fiche.";
RF_RF02_ATLAS_AGAIN = "L'atlas reste ouvert sur l'Afrique des cartes scolaires.";
RF_RF02_ENGINES = "Des moteurs, au nord. Réguliers, lourds, plusieurs colonnes.";
RF_RF02_BELL = "Une cloche, à l'ouest. Pas une église. Trois coups, un silence, trois autres.";
RF_RF02_PHONE_1 = "« Ardent ? »\n« Oui. »";
RF_RF02_PHONE_2 = "« Incident critique. Le secondaire ne remonte pas.\nLes journaux sont pleins depuis 03:17. On a perdu le quorum. »";
RF_RF02_PHONE_3 = "« Quel cluster ? »\n« Vous savez lequel. »\n« Non. »\n« Vous êtes d'astreinte. »";
RF_RF02_PHONE_4 = "« Je suis à Paris. »\n« Nous aussi. »";
RF_RF02_PHONE_5 = "La ligne se coupe. Une tonalité continue.\nSous le boîtier, quelqu'un a gravé à la pointe : Ø";
RF_RF02_PHONE_6 = "Le téléphone sonne encore une fois, puis se tait.";
RF_RF02_MORRIS = "L'image a duré le temps d'un battement. Le papier redevient une publicité pour une poudre dentifrice.\nSous l'ongle, la colle a pris une teinte grenat.";
RF_RF02_FOUNTAIN = "Il boit directement au filet d'eau. Le métal a un goût de rouille.";
RF_ITEM_TICKET = "Ticket poinçonné";
RF_ITEM_READERCARD = "Fiche de lecteur";
RF_NOTE_20 = "Une voiture d'enfant pleine de registres ficelés.";
RF_NOTE_21 = "Feuille de paie collée au trottoir par la pluie. Nom, adresse, retenues, total.\nLe salaire d'un homme devenu illisible en une nuit.";
RF_NOTE_22 = "Ordres de mouvement, laissez-passer, listes de véhicules.\nLe vent les colle aux rambardes et les rend à l'eau.";
RF_NOTE_23 = "Gare fermée. Les tableaux montrent des heures sans départ, des voies sans convois.";

