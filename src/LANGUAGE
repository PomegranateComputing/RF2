// RF04 - Luna Park, personnel technique (novel l. 451-551; docs/production/maps/RF04_FICHE.md)
RF_RF04_DATE = "Luna Park, porte Maillot - vendredi 14 juin 1940";
RF_RF04_EXIT = "La clef entra difficilement. Viktor dut la tourner avec les deux mains.\nLa serrure céda d'un coup, lui arrachant la peau de l'index sur une bavure de métal.\n\nL'escalier descendait sous le niveau du parc.";
RF_OBJ_RF04_0 = "Suivre le chemin de service.";
RF_OBJ_RF04_1 = "Pointer à la guérite.";
RF_OBJ_RF04_2 = "Prendre la clef de la sous-station.";
RF_OBJ_RF04_3 = "Suivre le battement du moteur.";
RF_OBJ_RF04_4 = "Passer derrière le décor du pont.";
RF_OBJ_RF04_5 = "Descendre dans le bassin du Niagara.";
RF_OBJ_RF04_6 = "Monter au quai des montagnes russes.";
RF_OBJ_RF04_7 = "Passer les tourniquets de la salle de danse.";
RF_OBJ_RF04_8 = "Traverser la salle de danse.";
RF_OBJ_RF04_9 = "Sortir par la porte latérale, derrière la piste.";
RF_OBJ_RF04_10 = "Ouvrir la sous-station.";
RF_RF04_RAIL = "Des rails étroits traversent le chemin, rouillés mais encore fixés aux traverses.\nViktor touche le métal du bout des doigts. Le rail est tiède ; une vibration légère remonte dans la main.";
RF_RF04_HUT_1 = "« Tu es en retard. »\nLa voix vient d'une guérite. Un homme y est assis : casquette d'employé, moustache blanche, un registre sur les genoux.";
RF_RF04_HUT_2 = "« Le parc est fermé. »\n« Pas pour le personnel. »";
RF_RF04_HUT_3 = "Des colonnes de noms, d'heures, de postes. Un doigt noir de graisse descend la page.\n« Ardent, Viktor. Électricité, relais, moteurs. Numéro dix-sept. »";
RF_RF04_HUT_4 = "« Zéro dix-sept. »\n« Si tu veux. » Il tend la main.";
RF_RF04_CLOCK_1 = "Viktor lui donne le carton de pointage. L'homme le glisse dans l'horloge fixée au mur. Le mécanisme claque.";
RF_RF04_CLOCK_2 = "Sur le carton, une heure imprimée en violet : 06:06.\nLa montre arrêtée ne marque plus six heures vingt : les aiguilles indiquent six heures six.";
RF_RF04_CLOCK_3 = "« On est quel jour ? »\n« Celui où ils entrent. »";
RF_RF04_CLOCK_4 = "« Qui ? »\n« Toujours les mêmes. » Il désigne un crochet où pendent des clefs à étiquettes de cuivre.";
RF_RF04_CLOCK_AGAIN = "Le carton est pointé : 06:06.";
RF_RF04_KEYS_EARLY = "Des clefs pendent au crochet, chacune avec son étiquette de cuivre. Le gardien attend un carton.";
RF_RF04_KEYS_1 = "ATELIER. PISTE. SOUS-STATION. CHAMBRE FROIDE. La dernière étiquette, plus claire, est gravée JERMA.\nViktor prend la clef de la sous-station.";
RF_RF04_KEYS_2 = "« Pas celle-là. »\n« Pourquoi ? »\n« Parce que c'est celle que tu prends. »";
RF_RF04_KEYS_3 = "« Les moteurs tournent ? »  « Un seul. »\n« Lequel ? »  « Tu l'entendras. »";
RF_RF04_KEYS_AGAIN = "Il reste quatre clefs au crochet.";
RF_RF04_HUT_EMPTY = "La guérite est vide. Le registre repose sur la chaise, ouvert à une page blanche.\nSur la vitre, tracé du bout d'un doigt gras : ERREUR Ø";
RF_RF04_BROOKLYN = "BROOKLYN BRIDGE, lettres rouges sur fond gris.\nDerrière les planches, aucun fleuve : un couloir technique encombré de câbles.";
RF_RF04_NIAGARA = "Un bassin vide porte une ligne d'algues sèches à hauteur d'épaule.\nUne pancarte annonce LES CHUTES DU NIAGARA.";
RF_RF04_SHOE_1 = "Au fond, une chaussure d'enfant repose dans une flaque noire.\nCuir blanc, boucle latérale, semelle presque neuve.";
RF_RF04_SHOE_2 = "Deux pieds filmés dans une chambre en 2007, cadrage bas, lumière jaune.\nLe souvenir n'est pas le sien. Il en reconnaît pourtant la compression, le souffle du microphone.";
RF_RF04_SHOE_3 = "Il détourne les yeux.";
RF_RF04_SHOE_AGAIN = "La chaussure reste dans la flaque.";
RF_RF04_MOTOR = "Un moteur bat quelque part sous le parc : deux pulsations, une pause, une troisième plus longue.\nÀ chaque intersection, le couloir où l'air est le plus chaud.";
RF_RF04_TURNSTILE = "Sous la marquise éventrée, les tourniquets bloquent l'accès à l'ancienne salle de danse.\nL'un d'eux porte encore un compteur : 617. Viktor pousse la barre. Le chiffre passe à 618.";
RF_RF04_HALL = "Le parquet a gondolé. Des miroirs piqués recouvrent les murs ; la lumière du matin y entre par fragments.";
RF_RF04_MIRROR_1 = "Les miroirs le multiplient en silhouettes inégales. Dans un reflet, il porte sa tenue noire.\nDans un autre, une blouse grise d'ouvrier.";
RF_RF04_MIRROR_2 = "Dans un troisième, une chemise claire tachée sous le bras, un badge plastique à la ceinture.\nL'image dure assez pour qu'il lise le badge : VIKTOR ARDENT - DATABASE ADMINISTRATOR";
RF_RF04_MIRROR_3 = "Il avance. Les reflets changent d'angle. Le badge disparaît.";
RF_RF04_JUKEBOX_1 = "Sous la bâche, un juke-box muet : vitre fendue, touches jaunies, liste de morceaux effacés.\nUne seule étiquette reste lisible : THE SKY IS EMPTY. Aucun interprète. Aucun numéro.";
RF_RF04_JUKEBOX_2 = "Il appuie. Rien.";
RF_RF04_JUKEBOX_3 = "Le moteur sous le parc répond par trois coups.";
RF_RF04_JUKEBOX_AGAIN = "Le juke-box se tait.";
RF_ITEM_CARD = "Carton de pointage 017 - Luna Park, personnel technique";
RF_ITEM_CARD_0606 = "Carton de pointage 017, pointé 06:06";
RF_KEY_SOUSSTATION = "Clef de la sous-station";
RF_PICKUP_SOUSSTATION = "Clef de la sous-station.";
RF_LOCK_SOUSSTATION = "Fermée. Il faut la clef de la sous-station.";
RF_LOCK_FROMINSIDE = "La porte s'ouvre de l'autre côté.";
RF_LOCK_SERVICE = "La porte de service est fermée.";

// RF05 - Les machines continuent (novel l. 551-707; docs/production/maps/RF05_FICHE.md)
RF_RF05_DATE = "Luna Park, sous le parc - vendredi 14 juin 1940";
RF_RF05_EXIT = "La porte donnait sur un couloir qui n'aurait pas dû tenir dans le bâtiment.\nBéton brut, plafond bas, conduites peintes en blanc.\nUne humidité salée couvrait les murs.";
RF_OBJ_RF05_0 = "Descendre à la sous-station.";
RF_OBJ_RF05_1 = "Trouver le moteur qui bat.";
RF_OBJ_RF05_2 = "Trouver le sectionneur.";
RF_OBJ_RF05_3 = "Nettoyer le palier, renforcer la courroie, remplacer le fusible de la ligne JERMA.";
RF_OBJ_RF05_4 = "Terminer la réparation.";
RF_OBJ_RF05_5 = "Pousser le levier sur MARCHE.";
RF_OBJ_RF05_6 = "Remonter dans le parc.";
RF_OBJ_RF05_7 = "Traverser le parc jusqu'à la salle de danse.";
RF_OBJ_RF05_8 = "Sortir par la porte de service, au fond de la salle.";
RF_RF05_STAIR = "L'escalier descend sous le niveau du parc. Plus bas, l'humidité a gonflé les mains courantes et verdi les conduites de cuivre.\nUne ampoule brûle derrière une grille. Sa lumière jaune forme un cercle précis sur le mur.";
RF_RF05_HEAT = "Une salle voûtée, moitié cave, moitié atelier. Au centre, un moteur entraîne une roue lourde par une courroie de cuir.\nC'est lui qui bat. Viktor retire son sweat : la chaleur d'une salle serveurs dont la climatisation a lâché.";
RF_RF05_DIALS_0 = "Tension instable. Intensité trop haute sur la ligne GRAND HUIT.\nLa ligne CHAMBRE DES GLACES reste à zéro.";
RF_RF05_DIALS_1 = "GRAND HUIT. SALLE DE DANSE. POMPES. ÉCLAIRAGE EXTÉRIEUR.\nL'aiguille de la ligne JERMA s'est arrêtée sur une valeur qui n'est pas inscrite dans l'échelle.";
RF_RF05_NODE_1 = "Un coffret sans plaque, sa peinture noire plus récente que le reste. À l'intérieur, pas de relais en cuivre :\ndes cartes minces, des diodes vertes, des ventilateurs de quarante millimètres. Sur une languette, au feutre blanc : NODE 0.";
RF_RF05_NODE_2 = "Il n'éprouve pas de surprise. La surprise suppose un monde stable qui vient d'être contredit.";
RF_RF05_NODE_AGAIN = "Les ventilateurs tournent. NODE 0.";
RF_RF05_NODE_RED = "Les diodes sont passées au rouge.";
RF_RF05_MOTOR_0 = "Le palier gauche chauffe ; la graisse est devenue une pâte noire. La courroie présente une fente à mi-largeur.\nAucun système n'aurait dû tourner dans cet état. Il cherche le sectionneur principal.";
RF_RF05_MOTOR_RUNNING = "Deux tours, hésitation, reprise. La courroie claque sur une réparation ancienne.";
RF_RF05_MOTOR_NEEDRAGS = "Le palier est plein de graisse durcie. Il faut de quoi nettoyer.";
RF_RF05_MOTOR_NEEDBELT = "La courroie ne peut pas être remplacée. Il faut de quoi la renforcer.";
RF_RF05_MOTOR_DONE = "Le palier est propre, la courroie renforcée.";
RF_RF05_MOTOR_AGAIN = "La réparation tiendra une heure ou trente secondes.";
RF_RF05_LEVER_1 = "Le levier porte deux positions : MARCHE et ARRÊT. Entre elles, gravé à la pointe, un troisième mot : ATTENTE.\nLa bakélite est tiède.";
RF_RF05_LEVER_2 = "Veuillez patienter. Votre demande est en cours. Un professionnel reviendra vers vous.\nLa rage monte. Pas contre la machine. Contre cette troisième position.";
RF_RF05_LEVER_3 = "Il tire le levier vers ARRÊT. Le moteur ralentit, la courroie claque encore trois fois, la roue s'immobilise.\nLe silence révèle ce que le bruit masquait : gouttes d'eau, petits mouvements dans les murs, une respiration derrière la porte.";
RF_RF05_WOMAN_1 = "Quelqu'un descend l'escalier. Dans le cercle de l'ampoule : la jeune femme à la valise de chaussures.\nElle n'a plus sa valise. Ses pieds sont nus et noirs de poussière.";
RF_RF05_WOMAN_2 = "« Vous avez arrêté. »  « C'était dangereux. »\n« C'était le seul qui tournait. »  « Justement. »";
RF_RF05_WOMAN_3 = "« Ils sont entrés dans Paris. »  « Je sais. »\n« Vous travaillez ici ? »  « Je crois. »";
RF_RF05_WOMAN_4 = "« Vous croyez beaucoup de choses qui vous font du mal. »\n« Vous devriez nettoyer votre pied. »  « Vous devriez lire vos résultats. »";
RF_RF05_WOMAN_5 = "Elle tient l'enveloppe blanche de Cochin. Son nom derrière la fenêtre ; l'adresse indique Waukegan, Illinois.\nSous la ligne, un numéro de chambre : 117. Elle la pose sur l'établi, à côté d'un bidon de graisse.";
RF_RF05_WOMAN_6 = "« Où avez-vous eu ça ? »  « Vous me l'avez donné. »\n« Non. »  « Pas encore. »";
RF_RF05_WOMAN_7 = "« Vous avez de l'eau ? » Il lui donne le flacon 117. Elle verse quelques gouttes sur la plaie de son talon.\nUne trace reste sur le tissu clair, nuance sombre, presque brune.";
RF_RF05_WOMAN_8 = "« Remettez-le en marche. »  « Pourquoi ? »  « Parce que vous êtes venu pour ça. »\n« Le parc est fermé. »  « Paris aussi. »";
RF_RF05_WOMAN_9 = "Elle remonte l'escalier. Avant de disparaître, elle pose la main sur le mur, dans le cercle de lumière.\nQuand elle la retire, ERREUR Ø apparaît sous sa paume, humide, noire.";
RF_RF05_REPAIR = "Il fait ce qu'il sait faire quand aucune décision n'est bonne : il ouvre les panneaux et commence par nettoyer.";
RF_RF05_DRAWER = "Des chiffons dans un tiroir, une burette d'huile, une clé plate de dix-sept. La mesure lui convient.";
RF_RF05_DRAWER_AGAIN = "Le tiroir est vide.";
RF_RF05_TOOLBOX = "Dans une caisse : une bande de toile, des agrafes de cuivre.\nDe quoi faire une réparation honteuse, mais fonctionnelle.";
RF_RF05_TOOLBOX_AGAIN = "La caisse est vide.";
RF_RF05_FUSEBOX = "Dans la boîte de rechange, un seul cylindre porte la bonne taille.\nSur sa porcelaine blanche, au lieu d'un ampérage, une date : 22.12.2022.";
RF_RF05_FUSEBOX_AGAIN = "Il n'y a pas d'autre fusible de cette taille.";
RF_RF05_BEARING_1 = "Il démonte le capot du palier, retire la graisse durcie, nettoie la bague.\nLes doigts, l'outil, la résistance du métal. Pas de symbole, pas de mémoire.";
RF_RF05_BEARING_2 = "Au fond du palier, un fragment de tissu pris dans la graisse : fibre synthétique rouge, impossible à dater.\nL'odeur qui monte n'est pas celle de l'huile. Mousse brûlée, sel, humidité d'hôtel.";
RF_RF05_BELT = "La courroie ne peut pas être remplacée. Il la renforce avec la toile et les agrafes de cuivre.\nDans une autre vie, il aurait ouvert un ticket. Ici, personne ne viendra valider.";
RF_RF05_FUSES_RUNNING = "On ne touche pas aux fusibles sous tension.";
