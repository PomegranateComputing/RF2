// Player: no Doom "oof" when use finds nothing; landing from a height is a body thud.
// Pain and death voices stay engine defaults until the RF01 audio batch provides Viktor's own.
rf/silence                "sounds/world/silence.wav"
$playeralias player male *usefail   rf/silence
$playeralias player female *usefail rf/silence
$playeralias player other *usefail  rf/silence
$playeralias player male *land      rf/impact/flesh
$playeralias player female *land    rf/impact/flesh
$playeralias player other *land     rf/impact/flesh

// Mix hierarchy (measured 2026-09-25 in the engine's own output, see docs/RF01_AUDIO.md): the
// player's weapons first, enemy threats next, impacts and handling, the ambience behind. The
// voice files sit near -9 dBFS RMS, above the gunshots, and the RFAMB01 bed played at -11 dBFS
// RMS the whole time: both are brought under the weapons.
$musicvolume RFAMB01 0.25
$volume rf/orderly/sight 0.5
$volume rf/orderly/pain 0.5
$volume rf/orderly/death 0.55
$volume rf/orderly/active 0.4
$volume rf/orderly/attack 0.55
$volume rf/brancardier/sight 0.5
$volume rf/brancardier/pain 0.5
$volume rf/brancardier/death 0.55
$volume rf/brancardier/active 0.4
$volume rf/porte/alert 0.6
$volume rf/porte/pain 0.6
$volume rf/porte/death 0.6
$volume rf/amb/hum 0.5
$volume rf/amb/wind 0.55
$volume rf/amb/drip 0.5
$volume rf/amb/room 0.45

// Dev only: film sync tone (scripts/film.py), played once before the filmed span.
rf/dev/sync               "sounds/dev/sync.wav"

