DefaultListMenu
{
    Font "RFMenu", "White"
    Selector "RFSELCT", -18, 4
    LineSpacing 18
}

ListMenu "MainMenu"
{
    Class "RFMainMenu"
    Position 56, 96
}

ListMenu "RFCreditsMenu"
{
    Class "RFCreditsMenu"
    Font "RFText", "White"
    LineSpacing 16
    Position 40, 80
}

ListMenu "SkillMenu"
{
    StaticText 56, 48, "$RF_MENU_SKILL", "Red"
    Position 56, 96
    LineSpacing 18
}

ListMenu "EpisodeMenu"
{
    Position 56, 96
    LineSpacing 18
}

// Game options, appended to the native Options menu (the native pages stay untouched).
OptionValue "RFCrosshairs"
{
    0, "$RF_OPT_CROSSHAIR_DOT"
    1, "$RF_OPT_CROSSHAIR_ENGINE"
}

OptionMenu "RFOptionsMenu"
{
    Title "$RF_OPT_TITLE"
    Slider "$RF_OPT_HUDSCALE", "rf_hud_scale", 0.75, 1.5, 0.05, 2
    Option "$RF_OPT_FOOTSTEPS", "rf_footsteps", "OnOff"
    Option "$RF_OPT_CROSSHAIR", "crosshair", "RFCrosshairs"
    StaticText ""
    StaticText "$RF_OPT_HUDSCALE_HINT", 1
}

AddOptionMenu "OptionsMenu"
{
    StaticText ""
    Submenu "$RF_OPT_TITLE", "RFOptionsMenu"
}

