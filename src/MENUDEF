DefaultListMenu
{
    Font "RFMenu", "White"
    Selector "RFSELCT", -18, 4
    LineSpacing 18
}

// RF2-UI-01: main menu and pause (one class, built from the game state), difficulty, credits and the
// engine's load/save lists are drawn by the RF classes of zscript/rf/menu.zs.
ListMenu "MainMenu"
{
    Class "RFMainMenu"
    Position 56, 96
}

ListMenu "RFCreditsMenu"
{
    Class "RFCreditsMenu"
    Font "RFText", "White"
    LineSpacing 16
    Position 40, 80
}

ListMenu "SkillMenu"
{
    Class "RFSkillMenu"
    Position 56, 96
    LineSpacing 18
}

ListMenu "EpisodeMenu"
{
    Position 56, 96
    LineSpacing 18
}

ListMenu "LoadGameMenu"
{
    NetgameMessage "$LOADNET"
    Position 80, 54
    Class "RFLoadMenu"
    Size Clean
}

ListMenu "SaveGameMenu"
{
    Position 80, 40
    Class "RFSaveMenu"
    Size Clean
}

// Options (UI spec): the native UZDoom pages in the order of the spec, the game's own settings,
// then the complete native menu for everything else.
OptionValue "RFCrosshairs"
{
    0, "$RF_OPT_CROSSHAIR_DOT"
    1, "$RF_OPT_CROSSHAIR_ENGINE"
}

OptionValue "RFOnOff"
{
    0, "$RF_OPT_NO"
    1, "$RF_OPT_YES"
}

OptionMenu "RFOptionsMenu"
{
    Class "RFOptionMenu"
    Title "$RF_OPT_TITLE"
    Submenu "$RF_OPT_DISPLAY", "VideoOptions"
    Submenu "$RF_OPT_VIDEOMODE", "VideoModeMenu"
    Submenu "$RF_OPT_SOUND", "SoundOptions"
    Submenu "$RF_OPT_MOUSE", "MouseOptions"
    Submenu "$RF_OPT_CONTROLS", "CustomizeControls"
    Submenu "$RF_OPT_JOYSTICK", "JoystickOptions"
    Submenu "$RF_OPT_ACCESSIBILITY", "AccessibilityOptions"
    StaticText ""
    Slider "$RF_OPT_HUDSCALE", "rf_hud_scale", 0.75, 1.5, 0.05, 2
    Option "$RF_OPT_FOOTSTEPS", "rf_footsteps", "RFOnOff"
    Option "$RF_OPT_CROSSHAIR", "crosshair", "RFCrosshairs"
    StaticText "$RF_OPT_HUDSCALE_HINT"
    StaticText ""
    Submenu "$RF_OPT_ADVANCED", "OptionsMenu"
}
