// RF2-ARSENAL test bench (not campaign code). Loaded only by JOUER_RF2_ARSENAL_ESSAI.cmd, on top of a frozen game
// build; the map ARSENAL is a firing range. The weapon classes RFBenchRapid and RFBenchMR73 are generated by
// scripts/arsenal/build_bench.py from an animation file (Astra's delivery, or the labelled placeholders): their
// states come from the file, their mechanics from the two base classes below. Every event is logged on the console
// (RF_BENCH ...), not on screen. Values marked provisional are bench values, not balance.

class RFBench play
{
    static void Log(String what)
    {
        Console.PrintfEx(PRINT_HIGH | PRINT_NONOTIFY, "RF_BENCH t=%d %s", Level.maptime, what);
    }
}

class RFBenchWeapon : Weapon abstract
{
    String SeqName;        // sequence being played, for the bench HUD
    int Shots;             // rounds actually fired
    int Baseline;          // rounds owned when the bench gave the weapon (loaded + reserve)
    bool Reloading;
    bool FireQueued;       // fire pressed during a reload: fire once the weapon is back

    virtual String SoundPrefix() { return ""; }
    virtual clearscope String Counter() { return ""; }
    virtual clearscope int Loaded() { return 0; }
    virtual int Capacity() { return 0; }

    clearscope int Reserve() const
    {
        if (Owner == null || AmmoType1 == null) return 0;
        let a = Owner.FindInventory(AmmoType1);
        return a == null ? 0 : a.Amount;
    }

    // Rounds are only moved at event frames: loaded + reserve + fired never changes.
    clearscope int Balance() const { return Loaded() + Reserve() + Shots - Baseline; }

    void Log(String what)
    {
        RFBench.Log(String.Format("arme=%s %s charge=%d reserve=%d tirs=%d ecart=%d", GetClassName(), what, Loaded(), Reserve(), Shots, Balance()));
    }

    void Mech(String event, int flags = 0)
    {
        if (Owner != null) Owner.A_StartSound(SoundPrefix() .. event, CHAN_ITEM, flags);
    }

    override void OnDeselect(bool fromPowerup, bool onToss)
    {
        Super.OnDeselect(fromPowerup, onToss);
        if (Reloading) Log("recharge_interrompue changement_d_arme");
        Reloading = false;
        FireQueued = false;
        if (Owner != null) { Owner.A_StopSound(CHAN_ITEM); Owner.A_ClearOverlays(101, 106); }
    }

    action void A_BenchSeq(String name)
    {
        invoker.SeqName = name;
    }

    action void A_BenchReady()
    {
        invoker.SeqName = "ready";
        A_WeaponReady(WRF_ALLOWRELOAD);
    }

    // Fire pressed at any tic of a reload is kept (a frame's action only runs when the frame starts).
    override void DoEffect()
    {
        Super.DoEffect();
        if (!Reloading || FireQueued || Owner == null || Owner.player == null || Owner.player.ReadyWeapon != self) return;
        if (Owner.player.cmd.buttons & BT_ATTACK)
        {
            FireQueued = true;
            Log("tir_demande_pendant_la_recharge");
        }
    }

    action void A_BenchDry()
    {
        invoker.Mech("dry");
        invoker.Log("dry");
    }

    // Any other event of the animation file: its sound if the file gives one, and a log line.
    action void A_BenchEvent(String event)
    {
        invoker.Mech(event);
        invoker.Log("evenement=" .. event);
    }

    action void A_BenchFireBullets(int pellets, int damage, double spreadH, double spreadV)
    {
        A_StartSound(invoker.SoundPrefix() .. "shot", CHAN_WEAPON, CHANF_OVERLAP);
        A_GunFlash();
        A_FireBullets(spreadH, spreadV, pellets, damage, "RFBulletPuff", FBF_NORANDOM);
    }

    action void A_BenchCase()
    {
        if (invoker.Owner != null) invoker.Owner.A_SpawnParticle(0xc9b982, SPF_RELVEL, 16, 1.35,
            18, -10, 5, 0, 0.1, 0.28, 0.14, 0, 0, -0.06, 0.95, -1, 0.07);
    }
}

// Pump-action shotgun: a tube magazine and a chamber. A shot empties the chamber and leaves a fired case in it; the
// pump stroke ejects the case (fore-end back) and chambers a shell from the tube (fore-end forward). Reload feeds the
// tube one shell at a time; it stops when the tube is full, the reserve is empty, fire is pressed (a shell being
// available) or the weapon is switched; a chamber left empty is filled by a pump stroke at the end.
class RFBenchPump : RFBenchWeapon abstract
{
    int Tube;
    bool Chambered;
    bool Spent;

    virtual int TubeCap() { return 5; }
    virtual bool CarriesChamber() { return true; }
    override int Capacity() { return TubeCap() + (CarriesChamber() ? 1 : 0); }
    override int Loaded() { return Tube + (Chambered ? 1 : 0); }
    override String Counter()
    {
        return String.Format("tube %d + chambre %d | reserve %d", Tube, Chambered ? 1 : 0, Reserve());
    }

    override void BeginPlay()
    {
        Super.BeginPlay();
        Tube = TubeCap();
        Chambered = CarriesChamber();
    }

    action State A_PumpFire()
    {
        if (invoker.Chambered) return ResolveState("FireSeq");
        if (invoker.Tube > 0)
        {
            invoker.Log("chambre_vide pompe_sans_tir");
            return ResolveState("PumpSeq");
        }
        return ResolveState("DrySeq");
    }

    action void A_PumpShot(int pellets, int damage, double spreadH, double spreadV)
    {
        if (!invoker.Chambered) { invoker.Log("ERREUR tir_sans_cartouche"); return; }
        invoker.Chambered = false;
        invoker.Spent = true;
        invoker.Shots++;
        A_BenchFireBullets(pellets, damage, spreadH, spreadV);
        invoker.Log(String.Format("shot plombs=%d degats=%d", pellets, damage));
    }

    action void A_PumpBack()
    {
        invoker.Mech("pump_back");
        if (invoker.Spent) { invoker.Spent = false; A_BenchCase(); invoker.Log("pump_back etui_ejecte"); }
        else invoker.Log("pump_back");
    }

    action void A_PumpFwd()
    {
        invoker.Mech("pump_fwd");
        if (!invoker.Chambered && invoker.Tube > 0) { invoker.Tube--; invoker.Chambered = true; invoker.Log("pump_fwd chambree"); }
        else invoker.Log("pump_fwd");
    }

    action State A_PumpAfterPump()
    {
        if (invoker.FireQueued && invoker.Chambered) { invoker.FireQueued = false; return ResolveState("Fire"); }
        invoker.FireQueued = false;
        return ResolveState("Ready");
    }

    action State A_PumpReloadCheck()
    {
        if (invoker.Tube >= invoker.TubeCap() || invoker.Reserve() <= 0) return ResolveState("Ready");
        invoker.Reloading = true;
        invoker.FireQueued = false;
        invoker.Log("recharge_debut");
        return null;
    }

    action void A_PumpShellIn()
    {
        invoker.Mech("shell_in");
        if (invoker.Tube < invoker.TubeCap() && invoker.Reserve() > 0 && invoker.Owner.TakeInventory(invoker.AmmoType1, 1, true))
        {
            invoker.Tube++;
            invoker.Log("shell_in");
        }
        else invoker.Log("shell_in sans_cartouche");
    }

    action State A_PumpShellNext()
    {
        if (invoker.FireQueued && (invoker.Chambered || invoker.Tube > 0)) return ResolveState("ReloadEndSeq");
        if (invoker.Tube < invoker.TubeCap() && invoker.Reserve() > 0) return ResolveState("ReloadShellSeq");
        return ResolveState("ReloadEndSeq");
    }

    action State A_PumpAfterReload()
    {
        invoker.Reloading = false;
        invoker.Log("recharge_fin");
        if (!invoker.Chambered && invoker.Tube > 0) return ResolveState("PumpSeq");
        if (invoker.FireQueued) { invoker.FireQueued = false; return ResolveState("Fire"); }
        return ResolveState("Ready");
    }
}

// Double-action revolver, six chambers. Partial reload rule (a): opening the cylinder ejects everything, the intact
// rounds go back to the reserve, the fired cases fall; then rounds go in one at a time up to six. The chamber layers
// (one image per chamber, drawn over the open cylinder) follow the number actually loaded.
class RFBenchRevolver : RFBenchWeapon abstract
{
    int Rounds;
    int Cases;

    virtual int Cylinder() { return 6; }
    override int Capacity() { return Cylinder(); }
    override int Loaded() { return Rounds; }
    override String Counter()
    {
        String cyl = "";
        for (int i = 0; i < 6; i++) cyl = cyl .. (i < Rounds ? "o" : (i < Rounds + Cases ? "x" : "."));
        return String.Format("barillet %s (%d) | reserve %d", cyl, Rounds, Reserve());
    }

    override void BeginPlay()
    {
        Super.BeginPlay();
        Rounds = Cylinder();
    }

    action State A_RevFire()
    {
        if (invoker.Rounds > 0) return ResolveState("FireSeq");
        return ResolveState("DrySeq");
    }

    action void A_RevShot(int pellets, int damage, double spreadH, double spreadV)
    {
        if (invoker.Rounds <= 0) { invoker.Log("ERREUR tir_sans_cartouche"); return; }
        invoker.Rounds--;
        invoker.Cases++;
        invoker.Shots++;
        A_BenchFireBullets(pellets, damage, spreadH, spreadV);
        invoker.Log(String.Format("shot degats=%d", damage));
    }

    action State A_RevReloadCheck()
    {
        if (invoker.Rounds >= invoker.Cylinder() || invoker.Reserve() <= 0) return ResolveState("Ready");
        invoker.Reloading = true;
        invoker.FireQueued = false;
        invoker.Log("recharge_debut");
        return null;
    }

    action void A_RevOpen()
    {
        invoker.Mech("cyl_open");
        invoker.Log("cyl_open");
    }

    action void A_RevEject()
    {
        invoker.Mech("eject");
        int intact = invoker.Rounds;
        if (intact > 0) invoker.Owner.GiveInventory(invoker.AmmoType1, intact);
        invoker.Rounds = 0;
        for (int i = 0; i < invoker.Cases; i++) A_BenchCase();
        invoker.Log(String.Format("eject intactes_rendues=%d etuis=%d", intact, invoker.Cases));
        invoker.Cases = 0;
    }

    action void A_RevRoundIn()
    {
        invoker.Mech("round_in");
        if (invoker.Rounds < invoker.Cylinder() && invoker.Reserve() > 0 && invoker.Owner.TakeInventory(invoker.AmmoType1, 1, true))
        {
            invoker.Rounds++;
            invoker.Log("round_in");
        }
        else invoker.Log("round_in sans_cartouche");
    }

    action State A_RevRoundNext()
    {
        if (invoker.FireQueued && invoker.Rounds > 0) return ResolveState("ReloadCloseSeq");
        if (invoker.Rounds < invoker.Cylinder() && invoker.Reserve() > 0) return ResolveState("ReloadRoundSeq");
        return ResolveState("ReloadCloseSeq");
    }

    action void A_RevClose()
    {
        invoker.Mech("cyl_close");
        invoker.Log("cyl_close");
    }

    action State A_RevAfterReload()
    {
        invoker.Reloading = false;
        invoker.Log("recharge_fin");
        if (invoker.FireQueued) { invoker.FireQueued = false; return ResolveState("Fire"); }
        return ResolveState("Ready");
    }

    // The six chamber layers exist while the cylinder is shown open; each shows its round when loaded.
    action void A_RevChambers(bool open)
    {
        if (!open) { A_ClearOverlays(101, 106); return; }
        A_Overlay(101, "Chamber1", true);
        A_Overlay(102, "Chamber2", true);
        A_Overlay(103, "Chamber3", true);
        A_Overlay(104, "Chamber4", true);
        A_Overlay(105, "Chamber5", true);
        A_Overlay(106, "Chamber6", true);
    }
}

// A paper target on a board: takes every hit, never falls, reports hits and damage per shot (per tic).
class RFBenchTarget : Actor
{
    int hits, damageSum, hitTic;
    String lastSource;

    Default
    {
        Radius 16;
        Height 72;
        Health 1000000;
        Mass 1000000;
        +SHOOTABLE
        +SOLID
        +NOBLOOD
        +DONTTHRUST
        +NODAMAGETHRUST
        +NEVERTARGET
        -COUNTKILL
    }

    override int DamageMobj(Actor inflictor, Actor source, int damage, Name mod, int flags, double angle)
    {
        if (hits > 0 && hitTic != Level.maptime) Report();
        hitTic = Level.maptime;
        hits++;
        damageSum += damage;
        lastSource = "?";
        if (source != null && source.player != null && source.player.ReadyWeapon != null) lastSource = source.player.ReadyWeapon.GetClassName();
        return damage;
    }

    override void Tick()
    {
        Super.Tick();
        if (hits > 0 && Level.maptime > hitTic) Report();
    }

    void Report()
    {
        String where = String.Format("%du %s", args[0], args[1] ? "sombre" : "claire");
        RFBench.Log(String.Format("impact cible=%s arme=%s touches=%d degats=%d", where, lastSource, hits, damageSum));
        let h = RFBenchHandler(EventHandler.Find('RFBenchHandler'));
        if (h != null) h.lastImpact = String.Format("cible %s : %d touche%s, %d degats (%s)", where, hits, hits > 1 ? "s" : "", damageSum, lastSource);
        hits = 0;
        damageSum = 0;
    }

    States
    {
    Spawn:
        RFTG A -1;
        Stop;
    }
}

class RFBenchHandler : EventHandler
{
    String lastImpact;

    override void WorldLoaded(WorldEvent e)
    {
        if (!(Level.MapName ~== "ARSENAL")) return;
        RFBench.Log(String.Format("banc=ARSENAL sauvegarde=%d", e.IsSaveGame));
        if (e.IsSaveGame || !playeringame[0] || players[0].mo == null) return;
        let pl = players[0].mo;
        pl.GiveInventory('RFBrowning', 1);
        pl.GiveInventory('RFPistolAmmo', 60);
        pl.GiveInventory('RFFAL', 1);
        pl.GiveInventory('RFRifleAmmo', 80);
        pl.GiveInventory('RFCrowbar', 1);
        RFBenchSetup.Give(pl);
    }

    override void RenderOverlay(RenderEvent e)
    {
        if (!(Level.MapName ~== "ARSENAL") || players[consoleplayer].mo == null) return;
        let pl = players[consoleplayer];
        int vw = 1280, vh = 720;
        Font f = NewSmallFont;
        Array<String> lines;
        lines.Push("\cfBANC D'ESSAI - ARSENAL\c- (hors campagne)");
        lines.Push(RFBenchSetup.Source());
        let w = RFBenchWeapon(pl.ReadyWeapon);
        if (w != null)
        {
            lines.Push(String.Format("\cj%s\c-  %s", w.GetTag(), w.Counter()));
            let psp = pl.FindPSprite(PSP_WEAPON);
            String letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            String frame = (psp != null && psp.Frame >= 0 && psp.Frame < 26) ? String.Format("image %s  %d t", letters.Mid(psp.Frame, 1), psp.Tics) : "";
            lines.Push(String.Format("sequence %s  %s%s", w.SeqName, frame, w.Reloading ? "  \ckrecharge\c-" : ""));
            int bal = w.Balance();
            lines.Push(String.Format("tirs %d  -  compte %s", w.Shots, bal == 0 ? "\cdjuste\c-" : String.Format("\cgECART %d\c-", bal)));
        }
        else if (pl.ReadyWeapon != null) lines.Push(String.Format("\cj%s\c-  (arme de reference)", pl.ReadyWeapon.GetTag()));
        if (lastImpact != "") lines.Push(lastImpact);
        lines.Push("\cu4 Rapid  5 MR73  1 Browning  2 FAL  3 pied-de-biche  -  R recharger\c-");
        double y = 12;
        for (int i = 0; i < lines.Size(); i++)
        {
            int tw = f.StringWidth(lines[i]);
            Screen.DrawText(f, Font.CR_WHITE, vw - 12 - tw, y, lines[i], DTA_VirtualWidth, vw, DTA_VirtualHeight, vh, DTA_KeepRatio, true);
            y += f.GetHeight() + 2;
        }
    }
}
